# ==============================================================================
# RAG VOICE INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="RAG Voice Intelligence Platform"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database (PostgreSQL for production, SQLite async supported for local dev)
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/rag_voice_db
# Local SQLite async: sqlite+aiosqlite:///./data/rag_voice.db
DATABASE_URL=sqlite+aiosqlite:///./data/rag_voice.db

# Redis Cache / Message Broker (falls back to internal async broker if unreachable)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
# Remote: http://localhost:6333
# Local embedded path supported when Qdrant server is offline
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./data/qdrant

# Storage (MinIO / AWS S3 or local directory fallback)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-voice-intelligence
S3_REGION=us-east-1
S3_SECURE=false

# Authentication & JWT Secrets (Argon2id + HS256/RS256)
JWT_SECRET=production_ultra_secret_jwt_key_at_least_32_bytes_long_1234567890
JWT_REFRESH_SECRET=production_ultra_secret_refresh_jwt_key_32_bytes_long_1234567890
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ENCRYPTION_KEY=mfa_fernet_encryption_key_32_urlsafe_base64_encoded==

# External AI Provider API Keys (Configurable / Replaceable)
LLM_PROVIDER=builtin
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

EMBEDDING_PROVIDER=builtin
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

STT_PROVIDER=builtin
STT_API_KEY=

TTS_PROVIDER=builtin
TTS_API_KEY=
TTS_VOICE=en-US-JennyNeural

# Security & Rate Limiting
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
